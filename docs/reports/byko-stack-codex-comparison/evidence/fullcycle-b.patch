+    def test_repeated_label_preserves_file_after_reopening(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            self.assertEqual(add_task(path, "A"), 1)
+            os.utime(path, ns=(1_600_000_000_000_000_000,) * 2)
+            before = path.read_bytes(), path.stat().st_mtime_ns
+            for _ in range(2):
+                self.assertEqual(add_task(Path(str(path)), "A"), 1)
+                self.assertEqual((path.read_bytes(), path.stat().st_mtime_ns), before)
+
+    def test_existing_duplicates_return_first_without_rewriting(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            path.write_text('[\n  {"id": 9, "label": "A"},\n'
+                            '  {"id": 2, "label": "A"},\n'
+                            '  {"id": 15, "label": "B"}\n]\n')
+            os.utime(path, ns=(1_600_000_000_000_000_000,) * 2)
+            before = path.read_bytes(), path.stat().st_mtime_ns
+            self.assertEqual(add_task(path, "A"), 9)
+            self.assertEqual((path.read_bytes(), path.stat().st_mtime_ns), before)
+
+    def test_labels_use_exact_string_equality(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            labels = ["A", "a", " A", "A ", "", " ", "é", "e\u0301"]
+            for task_id, label in enumerate(labels, 1):
+                with self.subTest(label=label):
+                    self.assertEqual(add_task(path, label), task_id)
+            for task_id, label in enumerate(labels, 1):
+                with self.subTest(repeated_label=label):
+                    self.assertEqual(add_task(path, label), task_id)
+            self.assertEqual(json.loads(path.read_text()), [
+                {"id": task_id, "label": label}
+                for task_id, label in enumerate(labels, 1)
+            ])
+
+    def test_new_label_uses_max_id_and_preserves_existing_rows(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            rows = [{"id": 12, "label": "A"}, {"id": 3, "label": "A"}]
+            path.write_text(json.dumps(rows))
+            self.assertEqual(add_task(str(path), "새 작업"), 13)
+            self.assertEqual(json.loads(path.read_text()),
+                             rows + [{"id": 13, "label": "새 작업"}])
+
+    def test_existing_empty_array_starts_at_one(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            path.write_text("[]")
+            self.assertEqual(add_task(path, "A"), 1)
+            self.assertEqual(json.loads(path.read_text()), [{"id": 1, "label": "A"}])
