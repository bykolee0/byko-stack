+    def test_repeat_reopens_without_writing(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            task_id = add_task(path, "A")
+            os.utime(path, ns=(1_000_000_000, 1_000_000_000))
+            before = (path.read_bytes(), path.stat().st_mtime_ns)
+            for _ in range(3):
+                self.assertEqual(add_task(Path(str(path)), "A"), task_id)
+                self.assertEqual((path.read_bytes(), path.stat().st_mtime_ns), before)
+            self.assertEqual(json.loads(path.read_text()), [{"id": 1, "label": "A"}])
+
+    def test_existing_duplicates_keep_first_and_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "tasks.json"
+            path.write_text('[ {"id": 9, "label": "A"},\n {"id": 2, "label": "A"} ]\n')
+            os.utime(path, ns=(1_000_000_000, 1_000_000_000))
+            before = (path.read_bytes(), path.stat().st_mtime_ns)
+            self.assertEqual(add_task(path, "A"), 9)
+            self.assertEqual((path.read_bytes(), path.stat().st_mtime_ns), before)
